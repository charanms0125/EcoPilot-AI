# EcoPilot AI — Environment Configuration Template
# Copy this file to .env and configure local variables as needed.
# Note: EcoPilot AI functions 100% locally without any external paid API keys.

# Environment Profile: development, test, production
ECOPILOT_ENV=development

# Database Configuration
ECOPILOT_DB_PATH=data/ecopilot.db

# Optional: Default electricity tariff in INR per kWh (default is 8.50)
ECOPILOT_DEFAULT_TARIFF_INR=8.50

# Optional: Default official grid emission factor key
# Supported options:
# - "India (CEA National Weighted Average)"
# - "India (CEA Renewable Energy Excluded - Thermal Dominant)"
# - "United States (EPA eGRID National Average)"
# - "United Kingdom (DESNZ / DEFRA National Grid)"
# - "European Union (EEA Average)"
ECOPILOT_GRID_EMISSION_FACTOR="India (CEA National Weighted Average)"

# Anomaly Detection Sensitivity (Z-score standard deviations)
ECOPILOT_DEFAULT_ANOMALY_SENSITIVITY_STD=2.4

# Production Security & Database Reset Safeguards
# In production, database reset is locked unless ECOPILOT_ALLOW_DB_RESET=true
ECOPILOT_ALLOW_DB_RESET=false
ECOPILOT_RESET_CONFIRM_KEY="CONFIRM_RESET_DATA"

# Optional: LLM Natural Language Explanation Polish (Disabled by default)
# The core application runs 100% offline using local Scikit-Learn models and deterministic heuristics.
# If you optionally want to enable LLM-generated natural language summaries, configure below:
ENABLE_LLM_POLISH=false
OPENAI_API_KEY=""
GEMINI_API_KEY=""
